{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,css \"node --watch server.js\" \"npm run dev:css\"",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify",
    "start": "node server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.1.0"
  }
}
