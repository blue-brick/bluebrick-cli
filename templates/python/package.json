{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,css \"flask --app app run --debug --port 3000\" \"npm run dev:css\"",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./static/styles.css --watch",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./static/styles.css --minify",
    "prestart": "npm run build:css",
    "start": "flask --app app run --port 3000",
    "start:prod": "npm run build:css && gunicorn app:app -b 127.0.0.1:3000"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
